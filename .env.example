# Paper is the default. Live trading runs only when MODE is exactly "live".
MODE=paper

# Burner wallet, base58 secret key. Required only when MODE=live.
# Paper mode ignores this value. Never commit a real key.
PRIVATE_KEY=

# Hard caps (enforced in src/config.ts — the process refuses to start outside them):
# Buy size is chosen in USD, then converted with a SOL/USD quote newer than 60s.
# The hard cap is $30 per buy.
# Buy slippage defaults to 5% and sell slippage to 10%. The hard cap stays 20%.
# MAX_SLIPPAGE_PCT is the fallback for a side whose own variable is unset.
# Jito tip is 1% of the trade, clamped to [0.0005, 0.0015] SOL.
# Hard floor is 0.0005 SOL. Hard ceiling is 0.005 SOL. JITO_TIP_MAX_SOL above 0.005 is refused.
# JITO_TIP_SOL is used only when JITO_TIP_PCT, JITO_TIP_MIN_SOL, and JITO_TIP_MAX_SOL are all unset.
# Open positions default 5, hard cap 5. Stop loss defaults to -20% and cannot
# exceed 20%. At +100% the bot sells half once. The rest rides a 20% trail
# that arms at +50% and never sits below break-even.
# Max hold is a timer exit, not a hard cap. Default 10 minutes.
BUY_SIZE_MIN_USD=5
BUY_SIZE_MAX_USD=30
# Fixed SOL size. When set, this replaces the USD confidence size.
# The buy is skipped when this times the live SOL/USD price is above $30.
BUY_SIZE_SOL=0.15
# Percent of total balance. When set, this replaces BUY_SIZE_SOL and the USD size.
# Paper total is PAPER_START_BALANCE_SOL plus realized PnL plus open cost basis,
# stored in data/paper-balance.json. Live total is the wallet plus open cost,
# minus LIVE_BALANCE_RESERVE_SOL. The $30 hard cap still clamps the buy.
# A buy below 0.005 SOL is skipped. Free cash must cover size plus fees and tip.
# BUY_SIZE_PCT_OF_BALANCE=15
# PAPER_START_BALANCE_SOL=0.36
# LIVE_BALANCE_RESERVE_SOL=0.02
BUY_SLIPPAGE_PCT=5
SELL_SLIPPAGE_PCT=10
# Dynamic tip. Emergency exits (stop, fast drop, dev sell) pay JITO_TIP_MAX_SOL.
JITO_TIP_PCT=0.01
JITO_TIP_MIN_SOL=0.0005
JITO_TIP_MAX_SOL=0.0015
# Legacy fixed tip. Ignored while any JITO_TIP_PCT / MIN / MAX key is set.
# JITO_TIP_SOL=0.002
# Optional. When set alone, this many lamports replaces JITO_TIP_SOL.
# JITO_TIP_LAMPORTS=2000000
# Watch a new mint instead of buying the create. 0 on ENTRY_WATCH_MAX_SEC buys at launch.
ENTRY_WATCH_MIN_SEC=15
ENTRY_WATCH_MAX_SEC=30
ENTRY_MIN_BUYS=8
ENTRY_MIN_UNIQUE_BUYERS=5
ENTRY_MIN_NET_BUY_SOL=1
# Optional early pass. Both keys are required, and ENTRY_EARLY_SEC must be below ENTRY_WATCH_MAX_SEC.
# At that time the bot buys if net buy SOL reaches the early threshold and the other gates already pass,
# including dev cap, top-10, and socials. Otherwise it keeps watching and uses ENTRY_MIN_NET_BUY_SOL at the end.
# ENTRY_EARLY_SEC=3
# ENTRY_EARLY_MIN_NET_BUY_SOL=1.2
ENTRY_MIN_BUY_RATIO=0.6
ENTRY_MAX_RUNUP_PCT=60
ENTRY_MAX_WATCHED=30
# A single print this far under the previous mark sells immediately.
STOP_FAST_DROP_PCT=12
# Creator sell closes the position. Set to false to disable.
DEV_SELL_EXIT=true
# Exit if the peak has not reached this gain within the window. 0 disables it.
EARLY_EXIT_MIN_GAIN_PCT=10
EARLY_EXIT_WINDOW_SEC=5
# Realized net PnL for the Europe/Berlin day, after fees and tips. Unset means off.
# Paper and live are counted separately and the total is kept in data/daily-pnl.json.
# At or below this loss, new watches and buys stop. Open positions still exit.
# When nothing is open, the bot writes STOP_FILE. A supervisor that exits while
# STOP exists (run-supervised.sh) will not start another trading process.
# Unrealized PnL is not included. Delete STOP and restart by hand after midnight.
# MAX_DAILY_LOSS_SOL=0.09
# Optional fixed entry-bucket width. Unset uses one third of the watch so far,
# so a 5s window can still require buys in 2 of 3 buckets.
# ENTRY_BUCKET_SEC=
# Metadata socials. Off by default. pump.fun does not verify these links;
# the check only requires a well-formed Twitter/X or Telegram value.
# REQUIRE_SOCIALS=false
# any = Twitter/X or Telegram. both = each one.
# REQUIRE_SOCIALS_MODE=any
# Retry a missing metadata document through the entry watch. A JSON body with
# no valid links is final and is not retried. The deadline defaults to the
# watch window, minus a short margin so the entry decision is not held past it.
# METADATA_RETRY=true
# METADATA_ATTEMPT_TIMEOUT_MS=1200
# METADATA_RETRY_DEADLINE_SEC=
# When true, a token that fails only the socials check stays in the watch.
# It can still enter on the early or full volume gates. Both time-stop keys
# are required and must be > 0. If peak gain is below the minimum at the
# time stop, the position sells in full. A token that reached the gain keeps
# the normal exits. Tokens with socials are unchanged.
# ALLOW_NO_SOCIALS_ENTRY=false
# NO_SOCIALS_TIME_STOP_SEC=3
# NO_SOCIALS_MIN_GAIN_PCT=20
# Once peak gain reaches the trigger, the stop floor moves to the floor percent
# and only ratchets up. Unset means off. The trail and the hard stop still apply;
# the higher floor wins.
# PROFIT_LOCK_TRIGGER_PCT=20
# PROFIT_LOCK_FLOOR_PCT=10
# Hard stop from the entry fill. Sells 100%. Hard cap 20.
STOP_LOSS_PCT=20
# For this many milliseconds after a fill, a mark more than the drop percent
# below entry is ignored. Unset disables the guard. The initial-curve sentinel
# stays on either way.
# POST_BUY_GUARD_MS=50
# POST_BUY_GUARD_DROP_PCT=20
# Trail arms at +50% (stop moves to at least break-even), then trails the peak by 20%.
TRAIL_ACTIVATE_PCT=50
TRAIL_DISTANCE_PCT=20
# At +100%, sell half once. The remainder uses the trail. TRAIL_TIERS and TAKE_PROFIT_PCT are ignored.
TP1_PCT=100
TP1_SELL_FRACTION=0.5
MAX_HOLD_MINUTES=10
LIQ_DROP_PCT=20
VOLUME_STALL_SEC=45
VOLUME_STALL_GRACE_SEC=90
SELL_PRESSURE_RATIO=3
SELL_PRESSURE_WINDOW_SEC=30
SAFETY_CHECK_TIMEOUT_MS=250

# Optional Yellowstone gRPC. When either value is empty the bot uses WS_URL.
# GRPC_TOKEN is a secret. It is redacted from logs and is not required.
GRPC_URL=
GRPC_TOKEN=
PRIORITY_FEE_SOL=0.00005
# Dynamic fee: Helius getPriorityFeeEstimate at High, else the 90th percentile of
# getRecentPrioritizationFees. The total is clamped to this many lamports (0.0005 SOL).
# A failed lookup uses PRIORITY_FEE_SOL. Paper mode books the same estimate in PnL.
PRIORITY_FEE_MAX_LAMPORTS=500000
PRIORITY_FEE_CACHE_MS=5000

# Paper fills use this adverse slippage, capped by BUY_SLIPPAGE_PCT on buys and SELL_SLIPPAGE_PCT on sells.
PAPER_SLIPPAGE_PCT=2
PAPER_PROTOCOL_FEE_BPS=100
PAPER_VENUE_FEE_BPS=25
PAPER_BASE_FEE_SOL=0.000005

# Market data. helius reads pump logs from RPC_WS_URL. pumpportal and pumpdev are fallbacks.
FEED=helius
# Seconds without a logs notification before the Helius socket reconnects. Default 30.
# FEED_STALL_SEC is still read when HELIUS_STALL_SEC is unset.
HELIUS_STALL_SEC=30
DATA_WS_URL=wss://pumpportal.fun/api/data
# New-token events are free. Trade subscriptions need a key whose wallet holds at least 0.02 SOL.
# The key is added to subscribeTokenTrade and is never logged or put in the URL.
# PUMPPORTAL_API_KEY=
# Used only when FEED=pumpdev.
WS_URL=wss://pumpdev.io/ws
# Optional PumpDev data key. Ignored by the PumpPortal feed. Never put it in the URL.
# PUMPDEV_API_KEY=
# Optional ceiling on PumpDev trade subscriptions, applied after the auth tier is known.
# PUMPDEV_MAX_SUBSCRIPTIONS=
# Helius WebSocket. FEED=helius requires this. api-key is redacted in logs.
# Also used for bonding-curve accountSubscribe. When unset, liquidity_drop uses the trade stream.
RPC_WS_URL=
# Local-sign Jito bundle. See README assumptions. Do not point this at a server that asks for PRIVATE_KEY.
TRADE_API_URL=https://pumpdev.io/api/bundle
RPC_URL=https://api.mainnet-beta.solana.com
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
SOL_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd

DATA_DIR=./data
STOP_FILE=./STOP
CONFIRM_TIMEOUT_MS=20000
SELL_MAX_ATTEMPTS=4
# Skip when the creator holds more than this percent of supply. Default 5, hard cap 10.
# CREATOR_MAX_HOLD_PCT is still accepted when MAX_CREATOR_HOLD_PCT is unset.
MAX_CREATOR_HOLD_PCT=5
# Top 10 holders, excluding the bonding curve, its token account, and the pump AMM pool.
MAX_TOP10_PCT=25
# Shared token bucket for every RPC call. Helius answers HTTP 429 often.
HELIUS_RPS=5
# Top-10 and creator-history budget. A check that does not finish skips the buy.
RUG_CHECK_TIMEOUT_MS=2000
# Successful read RPCs are reused for this many milliseconds.
RPC_CACHE_TTL_MS=3000
MAX_OPEN_POSITIONS=5
